{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "index.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "50mb" }
    }
  ],
  "routes": [
    { "src": "/static/(.*)", "dest": "/app/web/$1" },
    { "src": "/media/(.*)", "dest": "/app/data/img/$1" },
    { "src": "/(.*)", "dest": "/index.py" }
  ]
}
